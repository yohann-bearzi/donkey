program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, {IN_CH}, 1, {SP}]> x) {
        string c_pad_type = const()[name = string("c_pad_type"), val = string("valid")];
        tensor<int32, [2]> c_strides = const()[name = string("c_strides"), val = tensor<int32, [2]>([1, 1])];
        tensor<int32, [4]> c_pad = const()[name = string("c_pad"), val = tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [2]> c_dilations = const()[name = string("c_dilations"), val = tensor<int32, [2]>([1, 1])];
        int32 c_groups = const()[name = string("c_groups"), val = int32(1)];
        string to_fp16 = const()[name = string("to_fp16"), val = string("fp16")];
        tensor<fp16, [1, {IN_CH}, 1, {SP}]> x16 = cast(dtype = to_fp16, x = x)[name = string("cast_in")];
        tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]> W_a = const()[name = string("W_a"), val = tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
        tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]> W_b = const()[name = string("W_b"), val = tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64({OFF_B})))];
        tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]> W_c = const()[name = string("W_c"), val = tensor<fp16, [{OUT_CH}, {IN_CH}, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64({OFF_C})))];
        tensor<fp16, [1, {OUT_CH}, 1, {SP}]> y_a = conv(dilations = c_dilations, groups = c_groups, pad = c_pad, pad_type = c_pad_type, strides = c_strides, weight = W_a, x = x16)[name = string("conv_a")];
        tensor<fp16, [1, {OUT_CH}, 1, {SP}]> y_b = conv(dilations = c_dilations, groups = c_groups, pad = c_pad, pad_type = c_pad_type, strides = c_strides, weight = W_b, x = x16)[name = string("conv_b")];
        tensor<fp16, [1, {OUT_CH}, 1, {SP}]> y_c = conv(dilations = c_dilations, groups = c_groups, pad = c_pad, pad_type = c_pad_type, strides = c_strides, weight = W_c, x = x16)[name = string("conv_c")];
        tensor<fp16, [1, {OUT_CH}, 1, {SP}]> y_ab = add(x = y_a, y = y_b)[name = string("y_ab")];
        tensor<fp16, [1, {OUT_CH}, 1, {SP}]> y16 = add(x = y_ab, y = y_c)[name = string("y_abc")];
        string to_fp32 = const()[name = string("to_fp32"), val = string("fp32")];
        tensor<fp32, [1, {OUT_CH}, 1, {SP}]> y = cast(dtype = to_fp32, x = y16)[name = string("cast_out")];
    } -> (y);
}
