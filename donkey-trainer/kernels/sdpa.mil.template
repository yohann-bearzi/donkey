program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3510.2.1"}, {"coremlc-version", "3505.4.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, {DIM3}, 1, {SP}]> qkv) {
        string to_fp16 = const()[name = string("to_fp16"), val = string("fp16")];
        tensor<fp16, [1, {DIM3}, 1, {SP}]> qkv16 = cast(dtype = to_fp16, x = qkv)[name = string("cast_in")];

        // Slice concatenated input into Q, K, V along channel dim.
        tensor<int32, [4]> b0 = const()[name = string("b0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
        tensor<int32, [4]> b1 = const()[name = string("b1"), val = tensor<int32, [4]>([0, {DIM}, 0, 0])];
        tensor<int32, [4]> b2 = const()[name = string("b2"), val = tensor<int32, [4]>([0, {DIM2}, 0, 0])];
        tensor<int32, [4]> sz = const()[name = string("sz"), val = tensor<int32, [4]>([1, {DIM}, 1, {SP}])];
        tensor<fp16, [1, {DIM}, 1, {SP}]> qf = slice_by_size(x = qkv16, begin = b0, size = sz)[name = string("slice_q")];
        tensor<fp16, [1, {DIM}, 1, {SP}]> kf = slice_by_size(x = qkv16, begin = b1, size = sz)[name = string("slice_k")];
        tensor<fp16, [1, {DIM}, 1, {SP}]> vf = slice_by_size(x = qkv16, begin = b2, size = sz)[name = string("slice_v")];

        // Reshape each [1, DIM, 1, SP] -> [1, HEADS, HD, SP], transpose to [1, HEADS, SP, HD].
        tensor<int32, [4]> qsh = const()[name = string("qsh"), val = tensor<int32, [4]>([1, {HEADS}, {HD}, {SP}])];
        tensor<int32, [4]> pm  = const()[name = string("pm"),  val = tensor<int32, [4]>([0, 1, 3, 2])];
        tensor<fp16, [1, {HEADS}, {HD}, {SP}]> q4 = reshape(shape = qsh, x = qf)[name = string("rq")];
        tensor<fp16, [1, {HEADS}, {SP}, {HD}]> q  = transpose(perm = pm, x = q4)[name = string("tq")];
        tensor<fp16, [1, {HEADS}, {HD}, {SP}]> k4 = reshape(shape = qsh, x = kf)[name = string("rk")];
        tensor<fp16, [1, {HEADS}, {SP}, {HD}]> k  = transpose(perm = pm, x = k4)[name = string("tk")];
        tensor<fp16, [1, {HEADS}, {HD}, {SP}]> v4 = reshape(shape = qsh, x = vf)[name = string("rv")];
        tensor<fp16, [1, {HEADS}, {SP}, {HD}]> v  = transpose(perm = pm, x = v4)[name = string("tv")];

        // Score = Q · K^T via matmul(transpose_y=true). Output [1, HEADS, SP, SP].
        bool tx = const()[name = string("tx"), val = bool(false)];
        bool ty = const()[name = string("ty"), val = bool(true)];
        tensor<fp16, [1, {HEADS}, {SP}, {SP}]> sc1 = matmul(transpose_x = tx, transpose_y = ty, x = q, y = k)[name = string("mm_qk")];

        // Scale by 1/sqrt(HD).
        fp16 scv = const()[name = string("scv"), val = fp16({SCALE})];
        tensor<fp16, [1, {HEADS}, {SP}, {SP}]> sc2 = mul(x = sc1, y = scv)[name = string("scale")];

        // Add causal mask. Mask shape [1, 1, SP, SP] broadcasts across heads.
        tensor<fp16, [1, 1, {SP}, {SP}]> cm = const()[name = string("cm"), val = tensor<fp16, [1, 1, {SP}, {SP}]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
        tensor<fp16, [1, {HEADS}, {SP}, {SP}]> ms = add(x = sc2, y = cm)[name = string("masked")];

        // Softmax over last dim (key positions).
        int32 sax = const()[name = string("sax"), val = int32(-1)];
        tensor<fp16, [1, {HEADS}, {SP}, {SP}]> aw = softmax(axis = sax, x = ms)[name = string("sm")];

        // Attention · V. Output [1, HEADS, SP, HD].
        tensor<fp16, [1, {HEADS}, {SP}, {HD}]> a4 = matmul(transpose_x = tx, transpose_y = tx, x = aw, y = v)[name = string("mm_av")];

        // Transpose back to [1, HEADS, HD, SP] then reshape to [1, DIM, 1, SP].
        tensor<fp16, [1, {HEADS}, {HD}, {SP}]> at = transpose(perm = pm, x = a4)[name = string("ta")];
        tensor<int32, [4]> os = const()[name = string("os"), val = tensor<int32, [4]>([1, {DIM}, 1, {SP}])];
        tensor<fp16, [1, {DIM}, 1, {SP}]> y16 = reshape(shape = os, x = at)[name = string("ra")];

        // Cast back to fp32 for output.
        string to_fp32 = const()[name = string("to_fp32"), val = string("fp32")];
        tensor<fp32, [1, {DIM}, 1, {SP}]> y = cast(dtype = to_fp32, x = y16)[name = string("cast_out")];
    } -> (y);
}
